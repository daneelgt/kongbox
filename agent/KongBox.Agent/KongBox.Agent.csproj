<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- KONGBOX desktop agent. Windows build: tray icon, WinRT media session, Core Audio, SendInput. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KongBoxAgent</AssemblyName>
    <RootNamespace>KongBox.Agent</RootNamespace>
    <Product>KONGBOX</Product>
    <Company>KONGBOX</Company>
    <Description>KONGBOX desktop agent: feeds the KONGBOX Android desk panel over USB.</Description>
    <Version>0.1.0</Version>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.default.json" LogicalName="config.default.json" />
    <EmbeddedResource Include="settings.html" LogicalName="settings.html" />
    <EmbeddedResource Include="widgets.json" LogicalName="widgets.json" />
    <EmbeddedResource Include="templates.json" LogicalName="templates.json" />
    <!-- the phone's panel, served at /panel/ for the editor's live preview and for the Android WebView -->
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\*.*" LogicalName="www/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\widgets\*.*" LogicalName="www/widgets/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
