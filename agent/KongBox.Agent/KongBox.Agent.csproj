<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- KONGBOX desktop agent. Windows build: tray icon, WinRT media session, Core Audio, SendInput. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KongBoxAgent</AssemblyName>
    <RootNamespace>KongBox.Agent</RootNamespace>
    <Product>KONGBOX</Product>
    <Company>KONGBOX</Company>
    <Description>KONGBOX desktop agent: feeds the KONGBOX Android desk panel over USB.</Description>
    <Version>0.3.1</Version>
    <ApplicationIcon>kongbox.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- pinned: 2.1.11 and older bundle a SQLite with CVE-2025-6965 (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="config.default.json" LogicalName="config.default.json" />
    <EmbeddedResource Include="settings.html" LogicalName="settings.html" />
    <EmbeddedResource Include="widgets.json" LogicalName="widgets.json" />
    <EmbeddedResource Include="templates.json" LogicalName="templates.json" />
    <!-- release builds carry the phone app inside the exe (scripts/build.ps1 builds the APK first) -->
    <EmbeddedResource Include="..\..\dist\KongBox.apk" LogicalName="KongBox.apk" Condition="Exists('..\..\dist\KongBox.apk') And '$(Configuration)' == 'Release'" />
    <!-- the phone's panel, served at /panel/ for the editor's live preview and for the Android WebView -->
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\*.*" LogicalName="www/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\android\app\src\main\assets\www\widgets\*.*" LogicalName="www/widgets/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the window is WinForms: drop the WebView2 WPF assembly, which only drags in a conflicting WindowsBase -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
